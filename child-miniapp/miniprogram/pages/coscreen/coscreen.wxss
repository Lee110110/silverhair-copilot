.coscreen-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #000;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(0, 0, 0, 0.7);
}

.status-text {
  color: #4CAF50;
  font-size: 28rpx;
  font-weight: 600;
}

.end-btn {
  color: #E53935;
  font-size: 28rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border: 2rpx solid #E53935;
  border-radius: 8rpx;
}

.frame-canvas {
  position: absolute;
  top: 60rpx;
  left: 0;
}

.annotation-canvas {
  position: absolute;
  top: 60rpx;
  left: 0;
  z-index: 10;
}

.toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-top: 1rpx solid #eee;
}

.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
}

.tool-btn.active {
  background: #FFEBEE;
}

.tool-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.tool-name {
  font-size: 20rpx;
  color: #757575;
}