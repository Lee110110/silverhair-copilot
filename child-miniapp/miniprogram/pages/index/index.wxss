.loading {
  text-align: center;
  padding: 100rpx 0;
}

.sos-banner {
  background: linear-gradient(135deg, #E53935, #C62828);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  animation: sos-pulse 1.5s ease-in-out infinite;
}

@keyframes sos-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.85; }
}

.sos-banner-title {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.sos-banner-desc {
  display: block;
  color: rgba(255,255,255,0.9);
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.sos-banner-actions {
  display: flex;
  gap: 16rpx;
}

.btn-accept {
  background: #fff;
  color: #E53935;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}

.btn-call {
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-state .text-title {
  margin-bottom: 16rpx;
}

.empty-state .text-caption {
  margin-bottom: 48rpx;
  text-align: center;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.bind-btn {
  color: #E53935;
  font-size: 28rpx;
  font-weight: 600;
}

.elderly-card .card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.elderly-card .card-actions {
  display: flex;
  gap: 16rpx;
}